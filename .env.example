OPENROUTER_API_KEY=sk-or-...

# Ajoutes par le releve F0 de la V2.2 (docs/releve-fournisseurs.md).
# Cloudflare Workers AI en demande deux : le compte, et le jeton.
# Les deux se creent sur le palier gratuit, sans carte.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Leonardo n a pas d allocation gratuite renouvelable sur son API :
# le releve l a ecarte. La ligne reste pour le jour ou la question se rouvre.
LEONARDO_API_KEY=
