# La cle d OpenRouter. Depuis F1 elle n est plus le prealable dur du produit :
# sans elle, ses modeles sont grises avec leur raison, et l atelier fabrique
# quand meme chez Pollinations, qui ne demande ni compte ni cle et n a donc
# aucune ligne ici.
OPENROUTER_API_KEY=sk-or-...

# La cle de fal.ai, pour l essai E6 (essais/essai_video_planche.py) et lui
# seul : le sprite anime par un modele image-vers-video. Ce n est PAS un
# fournisseur du produit, et rien dans atelier/ ne la lit. Replicate en repli,
# si fal.ai ne convient pas ; la ligne existe pour le nom, rien d autre.
FAL_KEY=
REPLICATE_API_TOKEN=

# Leonardo n a pas d allocation gratuite renouvelable sur son API :
# le releve l a ecarte. La ligne reste pour le jour ou la question se rouvre.
LEONARDO_API_KEY=
