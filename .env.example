# La cle d OpenRouter. Depuis F1 elle n est plus le prealable dur du produit :
# sans elle, ses modeles sont grises avec leur raison, et l atelier fabrique
# quand meme chez Pollinations, qui ne demande ni compte ni cle et n a donc
# aucune ligne ici.
OPENROUTER_API_KEY=sk-or-...

# Ajoutes par le releve F0 de la V2.2 (docs/releve-fournisseurs.md).
# Cloudflare Workers AI en demande deux : le compte, et le jeton.
# Les deux se creent sur le palier gratuit, sans carte.
# La marche a suivre, en cinq gestes : docs/tranches/V2.2.md, section F4.
# Le piege : un jeton cree a la main veut Workers AI Read *et* Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Leonardo n a pas d allocation gratuite renouvelable sur son API :
# le releve l a ecarte. La ligne reste pour le jour ou la question se rouvre.
LEONARDO_API_KEY=
